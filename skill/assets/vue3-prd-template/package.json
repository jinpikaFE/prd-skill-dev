{
  "name": "vue3-prd-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
