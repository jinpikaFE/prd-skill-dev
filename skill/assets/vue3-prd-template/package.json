  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
